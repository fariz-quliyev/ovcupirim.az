# Copy to .env.staging (`cp .env.staging.example .env.staging`), then fill in every blank, and
# run docker-compose.staging.yml with `--env-file .env.staging` (never the default `.env` — that
# name is reserved for docker-compose.prod.yml so the two can never be run with each other's
# values by a missing flag). Never commit the resulting file.
#
# STAGING ONLY. Never put a real production secret in this file — see docs/staging-runbook.md.

# --- PostgreSQL ---
POSTGRES_DB=ovcuprim
POSTGRES_USER=ovcuprim
POSTGRES_PASSWORD=

# --- Backend: database (required) ---
CONNECTION_STRING=Host=postgres;Port=5432;Database=ovcuprim;Username=ovcuprim;Password=

# --- Backend: secrets (required) ---
# Both validated at startup, minimum 32 characters. Generate fresh ones for staging —
# never reuse a production key, and never reuse these for production later either:
#   openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=
AUTH_SECURITY_HASHING_KEY=

# --- Backend: host filtering (required) ---
# The real staging hostname or IP this API answers to behind the proxy. No safe default — the
# host refuses to start otherwise, exactly like production.
ALLOWED_HOSTS=

# --- Backend: CORS ---
# The staging frontend's own origin (same host as ALLOWED_HOSTS, with the scheme and, if not 80/443,
# the port docker-compose.staging.yml's web service publishes — see STAGING_HTTP_PORT below).
CORS_ALLOWED_ORIGIN=

# --- Backend: reverse proxy (required) ---
# Must match docker-compose.staging.yml's own network subnet exactly — do not change one without
# the other.
FORWARDED_KNOWN_NETWORK=172.29.0.0/24

# How many proxies sit between the visitor and the api container. 2 is the normal value here:
# STAGING_HTTP_PORT publishes `web` on loopback so a host-level nginx can terminate TLS in front of
# it, which is visitor -> host nginx -> web -> api. Left at 1, the API attributes every request to
# the container-network gateway (172.29.0.1), so every rate limit becomes one bucket shared by all
# visitors and the audit trail records the proxy rather than the caller.
# Verify after deploying: sign in, then check that RefreshTokens.CreatedByIp is a real public
# address and not 172.29.0.1.
FORWARDED_LIMIT=2

# --- Backend: media storage (required) ---
STORAGE_ROOT_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=/uploads

# --- Backend: SMS / payments — read but INERT in Staging ---
# ASPNETCORE_ENVIRONMENT=Staging (set inside docker-compose.staging.yml, not here) makes
# AddInfrastructure ignore both of these unconditionally and use the simulated SMS sender and
# payment gateway instead — see docker-compose.staging.yml's own header comment. Leave blank;
# filling them in has no effect while this environment is treated as simulated. If a confirmed
# Epoint sandbox or a safe Poctgoyercini test account is obtained later, that is a deliberate,
# separate decision to revisit — not something this file can turn on by itself.
SMS_POCTGOYERCINI_USERNAME=
SMS_POCTGOYERCINI_PASSWORD=
PAYMENTS_EPOINT_PUBLIC_KEY=
PAYMENTS_EPOINT_PRIVATE_KEY=

# The staging frontend's own return-redirect origin — still required by AddInfrastructure's own
# validation whenever real Epoint keys are present, which they never are here, so in practice this
# only matters if that policy changes. Set it anyway, to the same value as CORS_ALLOWED_ORIGIN.
PAYMENTS_FRONTEND_BASE_URL=

# --- Frontend build (optional) ---
# Leave blank for the same-origin topology (frontend and API behind the one nginx proxy) — the
# frontend's own API client already falls back to the relative path /api/v1.
VITE_API_BASE_URL=

# --- Staging-only: published port ---
# docker-compose.staging.yml's web service publishes this port (default 8080) rather than 80, so a
# staging rehearsal never has to fight whatever else may already be listening on 80 on a shared
# host. Change it to 80 only once nothing else on the target host needs that port.
STAGING_HTTP_PORT=8080
