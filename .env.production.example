# Copy to .env before running docker-compose.prod.yml (`cp .env.production.example .env`), then
# fill in every blank below. Never commit the resulting .env file.
#
# This mirrors .env.example's keys exactly — same names, same ASP.NET Core Section__Key
# convention — because docker-compose.prod.yml passes them straight through to the api container
# as environment variables. See docs/deployment.md for the full walkthrough and
# docs/production-runbook.md / docs/deployment-verification.md for what each one protects against.
#
# Nothing here has a safe guessed default. The application refuses to start without the ones
# marked required, exactly as it does in any other environment — see StorageSetup,
# HostFilteringSetup and AddInfrastructure's own fail-fast checks.

# --- PostgreSQL ---
# Used both to start the postgres container and to build CONNECTION_STRING below — keep them in
# sync, since nothing checks that they agree at compose time.
POSTGRES_DB=ovcuprim
POSTGRES_USER=ovcuprim
POSTGRES_PASSWORD=

# --- Backend: database (required) ---
# Host is the postgres service's name on the compose network, not a public hostname — leave it as
# "postgres" unless the topology in docker-compose.prod.yml changes.
CONNECTION_STRING=Host=postgres;Port=5432;Database=ovcuprim;Username=ovcuprim;Password=

# --- Backend: secrets (required) ---
# Both validated at startup, minimum 32 characters, unique per environment:
#   openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=
AUTH_SECURITY_HASHING_KEY=

# --- Backend: host filtering (required) ---
# Semicolon-separated real hostname(s) this API answers to behind the proxy, e.g.
# "ovcupirim.az;www.ovcupirim.az". Left blank, the host refuses to start outside Development.
ALLOWED_HOSTS=

# --- Backend: CORS ---
# The real frontend origin. Same-origin deployments (frontend and API behind the one nginx in
# docker-compose.prod.yml, the recommended shape) never actually trigger a CORS check, but this
# still has to be a real value — never a wildcard, since the frontend sends credentials.
CORS_ALLOWED_ORIGIN=https://ovcupirim.az

# --- Backend: reverse proxy (required if a proxy sits in front, which docker-compose.prod.yml's
# `web` container always does) ---
# The fixed subnet the `ovcupirim` network in docker-compose.prod.yml is defined with. Leave this
# as-is unless that subnet is changed there too — see README, "Running behind a reverse proxy".
FORWARDED_KNOWN_NETWORK=172.28.0.0/24

# How many proxies sit between the visitor and the api container. Every rate limit partitions on
# the address the API ends up with, so too low a value collapses all of them into one bucket shared
# by the entire internet, and the audit trail records the proxy instead of the caller.
#   2 = this file's own topology: visitor -> host nginx -> web -> api
# It stays 2 with a CDN in front rather than becoming 3, because the host nginx restores the real
# client address itself (deploy/nginx/cloudflare-realip.conf) and then emits a single-entry
# X-Forwarded-For. That is deliberate: the api trusts exactly one network
# (ForwardedHeaders__KnownNetworks__0 is a single slot), so the CDN's own ranges are handled at the
# edge, where they can be validated, instead of being listed here.
# Verify after deploying: sign in, then check that RefreshTokens.CreatedByIp is a real public
# address and not a 172.x container-network address.
FORWARDED_LIMIT=2

# --- Backend: media storage (required) ---
# Must be an absolute path, and must not resolve to the Development default — StorageSetup
# refuses to start otherwise. docker-compose.prod.yml mounts the uploads-data volume here.
STORAGE_ROOT_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=/uploads

# --- Deployment: where the web container publishes ---
# Host binding for the `web` container. Keep it on loopback: this host also serves another
# production site whose nginx owns :80/:443, and Docker's published-port DNAT sits ahead of ufw, so
# a 0.0.0.0 bind is reachable from the internet even when the firewall denies that port. The host
# nginx terminates TLS and proxies here. Change only the port, not the address.
PROD_HTTP_PORT=127.0.0.1:8081

# --- Backend: SMS gateway (required for OTP to actually send outside Development) ---
# See docs/sms-poctgoyercini.md. Leave both blank to keep the safe placeholder that refuses to
# send rather than silently delivering nothing — registration/login will fail loudly instead.
SMS_POCTGOYERCINI_USERNAME=
SMS_POCTGOYERCINI_PASSWORD=

# --- Backend: payments (required for the Epoint gateway to activate) ---
# See docs/payments-epoint.md. Leave both blank to keep the safe placeholder that refuses to
# create an order; purchasing a promotion will fail loudly instead of silently doing nothing.
PAYMENTS_EPOINT_PUBLIC_KEY=
PAYMENTS_EPOINT_PRIVATE_KEY=

# The real public frontend origin — required whenever the two keys above are set, or the API
# refuses to start (see backend/src/Ovcuprim.Infrastructure/DependencyInjection.cs).
PAYMENTS_FRONTEND_BASE_URL=https://ovcupirim.az

# --- Frontend build (optional) ---
# Leave blank for the recommended same-origin topology (frontend and API behind the one nginx
# proxy) — the frontend's own API client already falls back to the relative path /api/v1. Set
# this only if the API is deliberately served from a different origin than the frontend.
VITE_API_BASE_URL=
