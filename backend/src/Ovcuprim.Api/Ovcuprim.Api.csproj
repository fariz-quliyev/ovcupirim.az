<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The local Application Control policy blocks an assembly named Ovcuprim.Api, which stops
         the host and the integration tests from loading it. Only the output name changes; the
         root namespace stays Ovcuprim.Api. -->
    <AssemblyName>OvcuprimApi</AssemblyName>
    <RootNamespace>Ovcuprim.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The maintenance pass is internal because nothing in production calls it directly; the
         integration suite drives one pass at a time so the sweeps can be asserted. -->
    <InternalsVisibleTo Include="OvcuprimIntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ovcuprim.Infrastructure\Ovcuprim.Infrastructure.csproj" />
  </ItemGroup>

</Project>
