# Copy to .env and adjust. Never commit .env.
#
# Values marked DEPLOYMENT are facts about where the API runs. They have no safe default: the
# application refuses to start without them outside Development rather than guessing.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=ovcuprim
POSTGRES_USER=ovcuprim
POSTGRES_PASSWORD=ovcuprim_dev
POSTGRES_PORT=5433

# --- Backend: environment ---
ASPNETCORE_ENVIRONMENT=Development

# --- Backend: database ---
# The API reads ConnectionStrings__Default; this mirrors the compose defaults.
# Blank counts as absent — the host refuses to start.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=ovcuprim;Username=ovcuprim;Password=ovcuprim_dev

# --- Backend: secrets ---
# Both are validated at startup and must be at least 32 characters. Generate per environment and
# never reuse them between environments:
#   openssl rand -base64 48
# The Development values live in appsettings.Development.json and are clearly marked dev-only.
Auth__Jwt__SigningKey=
Auth__Security__HashingKey=

# --- Backend: tokens ---
Auth__Jwt__Issuer=ovcuprim
Auth__Jwt__Audience=ovcuprim-web

# --- Backend: CORS (DEPLOYMENT) ---
# Exact origins, never a wildcard: the frontend sends credentials.
Cors__AllowedOrigins__0=http://localhost:5173

# --- Backend: host filtering (DEPLOYMENT) ---
# Semicolon-separated hostnames this API answers to. An empty value or "*" is refused at startup
# outside Development, because the framework would otherwise accept any Host header silently.
#   AllowedHosts=ovcuprim.az;www.ovcuprim.az
AllowedHosts=

# --- Backend: reverse proxy (DEPLOYMENT) ---
# Every rate limit partitions on the caller's address, so the API has to be told which proxies may
# speak for a caller. Configure ONE of KnownProxies or KnownNetworks; ForwardLimit must equal the
# number of proxies in the chain. Nothing configured means forwarded headers are ignored and every
# visitor shares one bucket — see README, "Running behind a reverse proxy".
# ForwardedHeaders__KnownProxies__0=10.0.0.4
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/16
ForwardedHeaders__ForwardLimit=1

# --- Backend: listing quota ---
# Free listing submissions per category per calendar month, in Azerbaijan local time (UTC+4).
# Absent means unlimited, so this must be set before launch.
Listings__Quota__Default=10
# Per-category overrides, keyed by category id:
# Listings__Quota__Categories__37=5

# --- Backend: media storage (DEPLOYMENT) ---
# RootPath must be a persistent volume in production; uploads do not survive a container restart
# on ephemeral disk. PublicBaseUrl is what the API puts in image URLs.
Storage__Local__RootPath=wwwroot/uploads
Storage__Local__PublicBaseUrl=/uploads

# --- Backend: SMS gateway (DEPLOYMENT) ---
# Poctgoyercini (poctgoyercini.com) — see docs/sms-poctgoyercini.md for the request/response
# contract, the pre-activation checklist, and the account questions still open with the provider.
# Both values are required outside Development; leaving either blank keeps the safe placeholder
# that refuses to send instead of silently delivering nothing. Whether this is Bumer.az's existing
# account or a separate one obtained for OvcuPrim is a decision for whoever holds the provider
# relationship — this adapter works with either, unchanged.
#
# DO NOT paste a value found in Bumer.az's historical source or configuration files here. A prior
# audit found Bumer's old password exposed there and it must be treated as compromised — whatever
# goes here must be a current, freshly issued or rotated credential.
Sms__Poctgoyercini__Username=
Sms__Poctgoyercini__Password=

# --- Backend: payments (DEPLOYMENT) ---
# Epoint (epoint.az) — see docs/payments-epoint.md for the request/response contract, what is
# confirmed vs. inferred about it, and the checklist before any production credential is set here.
# Both PublicKey and PrivateKey are required outside Development; leaving either blank keeps the
# safe placeholder that refuses to create an order instead of silently doing nothing. Development
# always uses a simulated gateway regardless of what is set here — no real credential is ever
# needed, or read, to run or test this backend locally.
Payments__Epoint__PublicKey=
Payments__Epoint__PrivateKey=

# Where a payer's browser returns to after checkout. A UX convenience only — the backend never
# treats this redirect as proof of payment; only a verified, server-confirmed callback does.
# Must be the absolute public origin of the frontend (e.g. https://ovcuprim.az). Whenever the Epoint
# keys above are set outside Development, the host refuses to start if this is blank or relative.
Payments__FrontendBaseUrl=

# --- Tests ---
# The PostgreSQL-backed test project requires a database and fails without one. CI sets this; the
# local default is the development container.
# OVCUPRIM_TEST_DB=Host=localhost;Port=5433;Database=postgres;Username=ovcuprim;Password=ovcuprim_dev

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5080/api/v1
